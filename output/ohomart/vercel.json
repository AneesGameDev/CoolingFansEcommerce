{
  "version": 2,
  "buildCommand": "yarn build",
  "outputDirectory": "build",
  "framework": "create-react-app",
  "installCommand": "yarn install",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/index.js": {
      "memory": 1024,
      "maxDuration": 30
    }
  }
}
